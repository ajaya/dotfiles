# Ghostty terminal configuration
# Docs: https://ghostty.org/docs/config/reference

# --- Theme & Appearance ---
theme = tokyonight
#theme = Catppuccin Latte
background-opacity = 0.98
background-blur-radius = 20

# --- Font ---
font-family = "Iosevka Term Nerd Font"
font-size = 11

# --- Window ---
window-height = 54
window-width = 183
window-padding-x = 4
window-padding-y = 2
window-save-state = always

# --- Cursor ---
cursor-style = bar
cursor-style-blink = false

# --- Input & Clipboard ---
clipboard-paste-protection = false
copy-on-select = clipboard
mouse-hide-while-typing = true

# --- Shell ---
#shell-integration = bash
#confirm-close-surface = false
# Additive: unlisted features keep their defaults (cursor, title, path on).
# ssh-terminfo installs Ghostty's terminfo on hosts it SSHes to (needs tic
# there); ssh-env falls back to xterm-256color and passes COLORTERM,
# TERM_PROGRAM, TERM_PROGRAM_VERSION. Both since Ghostty 1.2.0.
shell-integration-features = ssh-env,ssh-terminfo

# --- Keybindings ---
keybind = shift+enter=text:\n
