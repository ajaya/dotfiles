{
  "aws.cloudformation.telemetry.enabled": false,
  "aws.telemetry": false,
  "claudeCode.hideOnboarding": true,
  "claudeCode.initialPermissionMode": "acceptEdits",
  "claudeCode.preferredLocation": "panel",
  "diffEditor.codeLens": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "diffEditor.hideOriginalLineNumbers": false,
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.accessibilitySupport": "off",
  "editor.fontFamily": "Iosevka Nerd Font",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.inlineSuggest.edits.showCollapsed": true,
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.occurrencesHighlight": "off",
  "editor.quickSuggestions": {
    "comments": false,
    "other": false,
    "strings": false
  },
  "editor.selectionHighlight": false,
  "editor.suggestOnTriggerCharacters": false,
  "editor.tabCompletion": "on",
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 160,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.patterns": {
    "*.db": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.s3db": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.sqlite": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.ts": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "tsconfig.json": "tsconfig.*.json"
  },
  "[feature]": {
    "editor.defaultFormatter": "alexkrechik.cucumberautocomplete"
  },
  "files.autoSave": "onFocusChange",
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "never",
  "git.replaceTagsWhenPull": true,
  "indentRainbow.colors": [
    "rgba(255,255,64,0.07)",
    "rgba(127,255,127,0.07)",
    "rgba(255,127,255,0.07)",
    "rgba(79,236,236,0.07)"
  ],
  "indentRainbow.ignoreErrorLanguages": [
    "erb",
    "html.erb"
  ],
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "languageServerHerb.formatter.enabled": true,
  "redhat.telemetry.enabled": false,
  "scm.diffDecorationsIgnoreTrimWhitespace": "true",
  "security.workspace.trust.untrustedFiles": "open",
  "sqldeveloper.telemetry.enabled": false,
  "svg.preview.mode": "img",
  "terminal.explorerKind": "external",
  "terminal.integrated.accessibleViewPreserveCursorPosition": true,
  "terminal.integrated.allowMnemonics": true,
  "terminal.integrated.shellIntegration.environmentReporting": true,
  "window.confirmSaveUntitledWorkspace": false,
  "window.density.layout": "compact",
  "workbench.colorTheme": "Catppuccin Latte",
  "workbench.editor.enablePreview": false,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "workbench.experimental.modernUI": true,
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "workbench.startupEditor": "none",
  "[yaml]": {
    "editor.defaultFormatter": "PascalReitermann93.vscode-yaml-sort"
  }
}
